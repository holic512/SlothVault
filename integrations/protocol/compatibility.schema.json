{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/holic512/SlothVault/integrations/protocol/compatibility.schema.json",
  "title": "SlothVault authenticated MCP compatibility response",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "serverName", "serverVersion", "minimumClientVersion", "supportedProtocolVersions"],
  "properties": {
    "schema": {"const": 1},
    "serverName": {"const": "slothvault-admin-mcp"},
    "serverVersion": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "minimumClientVersion": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "supportedProtocolVersions": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}}
  }
}
