{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/holic512/SlothVault/integrations/protocol/component-manifest.schema.json",
  "title": "SlothVault independent component Release manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "module", "version", "asset", "sha256", "bridgeApiMajor", "protocolMajor", "files"],
  "properties": {
    "schema": {"const": 1},
    "module": {"enum": ["skill", "deployment"]},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "asset": {"type": "string", "pattern": "^slothvault-(skill|deployment)-[0-9]+\\.[0-9]+\\.[0-9]+\\.tgz$"},
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "bridgeApiMajor": {"type": "integer", "minimum": 1},
    "protocolMajor": {"type": "integer", "minimum": 1},
    "minPython": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+$"},
    "files": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {"pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"},
      "additionalProperties": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
    }
  }
}
