{
  "name": "@slothvault/plugin-sdk",
  "version": "1.4.0",
  "type": "module",
  "license": "MIT",
  "files": [
    "dist",
    "cli.mjs",
    "README.md",
    "LICENSE"
  ],
  "bin": {
    "slothvault-plugin": "./cli.mjs"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
