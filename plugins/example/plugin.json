{
  "schema": 1,
  "id": "slothvault.example",
  "name": "Extension example",
  "version": "1.1.0",
  "author": "holic512",
  "description": "Installable SDK example: pages, slots, modal, API, hooks, jobs and an owned table.",
  "engines": {
    "slothvault": ">=2.7.8 <3",
    "sdk": "^1.2.0",
    "node": ">=24.22.1"
  },
  "server": "server/index.mjs",
  "capabilities": [
    "database",
    "events"
  ],
  "configSchema": {
    "type": "object",
    "properties": {
      "message": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200
      }
    },
    "required": [
      "message"
    ],
    "additionalProperties": false
  },
  "configDefaults": {
    "message": "Hello from an independently installed plugin"
  },
  "tables": [
    {
      "name": "counters",
      "columns": [
        {
          "name": "id",
          "type": "string",
          "length": 100,
          "primary": true
        },
        {
          "name": "value",
          "type": "integer"
        }
      ]
    },
    {
      "name": "deliveries",
      "columns": [
        {
          "name": "id",
          "type": "string",
          "length": 100,
          "primary": true
        }
      ]
    }
  ],
  "migrations": [
    "initial"
  ],
  "api": [
    {
      "key": "status",
      "path": "status",
      "method": "GET",
      "access": {
        "audience": "public"
      }
    }
  ],
  "events": [
    "core.article.published",
    "core.project-version.published"
  ],
  "jobs": [
    {
      "key": "tick",
      "intervalSeconds": 60
    }
  ],
  "ui": [
    {
      "key": "admin",
      "asset": "client/admin.js",
      "surface": "admin",
      "kind": "page",
      "title": "Extension example",
      "titleZh": "插件示例",
      "menu": true,
      "access": {
        "audience": "admin"
      },
      "icon": "blocks"
    },
    {
      "key": "account",
      "asset": "client/account.js",
      "surface": "account",
      "kind": "page",
      "title": "Extension example",
      "titleZh": "插件示例",
      "menu": true,
      "access": {
        "audience": "user"
      },
      "icon": "blocks"
    },
    {
      "key": "public",
      "asset": "client/public.js",
      "surface": "public",
      "kind": "page",
      "title": "Extension example",
      "titleZh": "插件示例",
      "menu": true,
      "access": {
        "audience": "public"
      },
      "icon": "blocks"
    },
    {
      "key": "banner",
      "asset": "client/banner.js",
      "surface": "public",
      "kind": "slot",
      "slot": "public.home.before",
      "title": "Extension example",
      "access": {
        "audience": "public"
      },
      "icon": "blocks"
    },
    {
      "key": "article-action",
      "asset": "client/article-action.js",
      "surface": "admin",
      "kind": "slot",
      "slot": "admin.article.actions",
      "title": "Extension example",
      "access": {
        "audience": "admin"
      },
      "icon": "blocks"
    }
  ],
  "display": {
    "name": {
      "zh": "扩展示例",
      "en": "Extension example"
    },
    "description": {
      "zh": "展示独立插件的页面、插槽和后台任务。",
      "en": "Installable SDK example: pages, slots, modal, API, hooks, jobs and an owned table."
    },
    "config": {
      "message": {
        "label": {
          "zh": "展示消息",
          "en": "Display message"
        },
        "description": {
          "zh": "显示给用户的自定义文本；内容不会自动翻译。",
          "en": "Custom text shown to users; its content is not automatically translated."
        }
      }
    }
  }
}
