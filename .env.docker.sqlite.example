# SQLite-only Docker Compose deployment.
# Copy this file to .env.docker.sqlite before starting the SQLite compose file.

PORT=3000
DOCKER_IMAGE=holic512/slothvault:latest

# Optional. When omitted, the persistent config directory stores a generated key.
ENCRYPTION_KEY=

# This directory contains config/, database/, and uploads/ for SQLite mode only.
APP_DATA_DIR=./docker-data/sqlite/app
