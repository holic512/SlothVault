{
  "name": "slothvault",
  "version": "2.7.13",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.22.1"
  },
  "scripts": {
    "dev": "next dev",
    "build": "npm run prisma:generate && npm run plugins:build && next build",
    "postbuild": "node scripts/sanitize-standalone.mjs",
    "start": "next start",
    "lint": "eslint .",
    "lint:styles": "stylelint \"src/**/*.css\"",
    "typecheck": "tsc --noEmit",
    "mcp:docs": "node scripts/generate-mcp-docs.mjs",
    "mcp:docs:check": "node scripts/generate-mcp-docs.mjs --check",
    "test": "vitest run",
    "test:visual": "playwright test",
    "test:visual:update": "playwright test --update-snapshots",
    "prisma:generate": "node scripts/generate-prisma.mjs",
    "prisma:validate": "node scripts/generate-prisma.mjs --validate",
    "postinstall": "npm run prisma:generate",
    "version:prepare": "node scripts/release-version.mjs --prepare",
    "plugins:build": "node scripts/build-plugins.mjs",
    "predev": "npm run plugins:build",
    "plugins:pack": "node scripts/plugin-release-assets.mjs",
    "verify:plugins": "npm run plugins:build && npm run plugins:pack && npm test -- scripts/plugin-release-assets.test.mjs scripts/release-delivery.test.mjs scripts/release-version.test.mjs && npm run typecheck && npm test -- src/server/plugins src/server/services/points.test.ts src/server/database/mysql-migrations.integration.test.ts --maxWorkers=2"
  },
  "dependencies": {
    "@ant-design/cssinjs": "2.1.2",
    "@ant-design/icons": "6.3.2",
    "@ant-design/nextjs-registry": "1.3.0",
    "@fontsource/public-sans": "5.2.7",
    "@fontsource/source-sans-pro": "5.2.5",
    "@modelcontextprotocol/sdk": "1.32.1",
    "@prisma/adapter-better-sqlite3": "7.10.1",
    "@prisma/adapter-mariadb": "7.10.1",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@solana/spl-token": "0.4.15",
    "@solana/wallet-adapter-base": "0.9.27",
    "@solana/wallet-adapter-react": "0.15.39",
    "@solana/wallet-adapter-react-ui": "0.9.39",
    "@solana/web3.js": "1.98.4",
    "@tanstack/react-query": "5.101.4",
    "@uiw/react-md-editor": "4.1.1",
    "antd": "6.5.1",
    "archiver": "7.0.1",
    "argon2": "0.44.0",
    "better-sqlite3": "12.11.1",
    "bs58": "6.0.0",
    "clsx": "2.1.1",
    "dayjs": "1.11.23",
    "dompurify": "3.4.17",
    "dotenv": "17.4.2",
    "echarts": "6.1.0",
    "kysely": "0.29.6",
    "lucide-react": "1.24.0",
    "mariadb": "3.5.4",
    "mermaid": "12.2.0",
    "next": "16.4.2",
    "next-intl": "4.13.7",
    "next-themes": "0.4.6",
    "pg": "8.16.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "10.1.0",
    "rehype-autolink-headings": "7.1.0",
    "rehype-raw": "7.0.0",
    "rehype-sanitize": "6.0.0",
    "rehype-slug": "6.0.0",
    "remark-gfm": "4.0.1",
    "remark-parse": "11.0.0",
    "remark-rehype": "11.1.2",
    "semver": "7.8.5",
    "sharp": "0.35.5",
    "tweetnacl": "1.0.3",
    "unified": "11.0.5",
    "unzipper": "0.12.5",
    "zod": "4.4.3",
    "zustand": "5.0.15",
    "rollup": "4.64.7",
    "typescript": "5.9.3",
    "@rollup/plugin-commonjs": "29.0.3",
    "@rollup/plugin-node-resolve": "16.0.3"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@types/archiver": "7.0.0",
    "@types/better-sqlite3": "7.6.13",
    "@types/node": "24.19.2",
    "@types/pg": "8.15.6",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@types/semver": "7.7.1",
    "@types/sharp": "0.31.1",
    "@types/unzipper": "0.10.11",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.2",
    "fast-check": "4.5.3",
    "prisma": "7.10.1",
    "stylelint": "17.14.1",
    "stylelint-config-standard": "40.0.0",
    "vitest": "4.1.11"
  },
  "packageManager": "npm@11.19.1",
  "slothvaultRelease": {
    "pluginAssets": true
  }
}
