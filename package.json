{
  "name": "slothvault",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "npm run dev:services && next dev",
    "dev:app": "next dev",
    "dev:services": "docker compose up -d --wait --wait-timeout 60 redis",
    "dev:services:stop": "docker compose stop redis",
    "build": "npm run prisma:generate && next build",
    "postbuild": "node scripts/sanitize-standalone.mjs",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prisma:generate": "node scripts/generate-prisma.mjs",
    "prisma:validate": "node scripts/generate-prisma.mjs --validate",
    "postinstall": "npm run prisma:generate"
  },
  "dependencies": {
    "@ant-design/cssinjs": "2.1.2",
    "@ant-design/icons": "6.3.2",
    "@ant-design/nextjs-registry": "1.3.0",
    "@aws-sdk/client-s3": "3.1038.0",
    "@fontsource/public-sans": "5.2.7",
    "@fontsource/source-sans-pro": "5.2.5",
    "@prisma/adapter-better-sqlite3": "7.3.0",
    "@prisma/adapter-mariadb": "7.3.0",
    "@prisma/adapter-pg": "7.3.0",
    "@prisma/client": "7.3.0",
    "@solana/spl-account-compression": "0.1.10",
    "@solana/wallet-adapter-base": "0.9.27",
    "@solana/wallet-adapter-react": "0.15.39",
    "@solana/wallet-adapter-react-ui": "0.9.39",
    "@solana/web3.js": "1.98.4",
    "@tanstack/react-query": "5.101.2",
    "@uiw/react-md-editor": "4.1.1",
    "antd": "6.5.1",
    "archiver": "7.0.1",
    "argon2": "0.44.0",
    "better-sqlite3": "12.11.1",
    "bs58": "6.0.0",
    "clsx": "2.1.1",
    "dayjs": "1.11.19",
    "dotenv": "17.4.2",
    "lucide-react": "1.24.0",
    "mariadb": "3.4.5",
    "next": "16.2.10",
    "next-intl": "4.13.2",
    "next-themes": "0.4.6",
    "pg": "8.16.3",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-markdown": "10.1.0",
    "redis": "6.1.0",
    "rehype-autolink-headings": "7.1.0",
    "rehype-raw": "7.0.0",
    "rehype-sanitize": "6.0.0",
    "rehype-slug": "6.0.0",
    "remark-gfm": "4.0.1",
    "sharp": "0.34.5",
    "tweetnacl": "1.0.3",
    "unzipper": "0.12.3",
    "zod": "4.4.3",
    "zustand": "5.0.14"
  },
  "devDependencies": {
    "@types/archiver": "7.0.0",
    "@types/better-sqlite3": "7.6.13",
    "@types/node": "24.10.4",
    "@types/pg": "8.15.6",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@types/sharp": "0.31.1",
    "@types/unzipper": "0.10.11",
    "eslint": "9.39.5",
    "eslint-config-next": "16.2.10",
    "fast-check": "4.5.3",
    "prisma": "7.3.0",
    "typescript": "5.9.3",
    "vitest": "4.0.16"
  },
  "packageManager": "npm@11.6.2"
}
