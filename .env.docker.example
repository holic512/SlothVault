# SlothVault Docker deployment example.
# Copy to .env.docker. Database connection details are entered only in /install;
# the POSTGRES_* and MYSQL_* values below configure optional Compose containers.

PORT=3000
DOCKER_IMAGE=holic512/slothvault:latest

# Optional. Leave empty to generate a stable master key in CONFIG_DIR.
# Once installation starts, changing this value makes database.enc and existing
# encrypted Solana secrets unreadable.
ENCRYPTION_KEY=

# Local bind mount directories used by docker-compose.yml.
CONFIG_DIR=./docker-data/config
DATABASE_DIR=./docker-data/database
UPLOADS_DIR=./docker-data/uploads

# Default development/runtime Redis. Host-side `npm run dev` starts this service
# and connects through redis://127.0.0.1:6379; the app container uses redis://redis:6379.
REDIS_PORT=6379
REDIS_DATA_DIR=./docker-data/redis
REDIS_URL=redis://redis:6379
REDIS_PREFIX=slothvault

# Optional PostgreSQL profile: docker compose --profile postgres ...
POSTGRES_DATA_DIR=./docker-data/postgres
POSTGRES_DB=slothvault
POSTGRES_USER=slothvault
POSTGRES_PASSWORD=replace-with-a-strong-postgresql-password

# Optional MySQL profile: docker compose --profile mysql ...
MYSQL_DATA_DIR=./docker-data/mysql
MYSQL_DATABASE=slothvault
MYSQL_USER=slothvault
MYSQL_PASSWORD=replace-with-a-strong-mysql-password
MYSQL_ROOT_PASSWORD=replace-with-a-strong-mysql-root-password
