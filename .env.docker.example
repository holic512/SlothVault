# SlothVault Docker deployment example.
# Copy this file to .env.docker and replace the secrets before starting.

PORT=3000
DOCKER_IMAGE=holic512/slothvault:latest

DB_HOST=postgres
DB_PORT=5432
DB_NAME=slothvault
DB_USER=slothvault
DB_PASSWORD=replace-with-a-strong-database-password
DB_WAIT_TIMEOUT=60

ENCRYPTION_KEY=replace-with-a-stable-random-secret
UPLOAD_STORAGE_PATH=/app/data/uploads

# Local bind mount directories used by docker-compose.yml.
POSTGRES_DATA_DIR=./docker-data/postgres
UPLOADS_DIR=./docker-data/uploads
