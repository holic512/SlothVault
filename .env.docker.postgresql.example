# PostgreSQL Docker Compose deployment.
# Copy this file to .env.docker.postgresql, then set the required password.

PORT=3000
DOCKER_IMAGE=holic512/slothvault:latest
ENCRYPTION_KEY=

# The two PostgreSQL-mode directories never overlap with SQLite or MySQL data.
APP_DATA_DIR=./docker-data/postgresql/app
POSTGRES_DATA_DIR=./docker-data/postgresql/database

POSTGRES_DB=slothvault
POSTGRES_USER=slothvault
POSTGRES_PASSWORD=
