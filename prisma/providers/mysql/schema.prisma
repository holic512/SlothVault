// @file prisma/providers/mysql/schema.prisma
// @project SlothVault
// @module MySQL persistence model
// @description Defines the flat, domain-prefixed MySQL 8 schema for publishing, user identity, contracts, points, gift cards, and transaction evidence.
// @logic Preserve the provider-neutral logical model while applying MySQL-native types and binding optional Solana evidence to immutable releases and frozen contracts.
// @dependencies Prisma ORM 7.3.0, @prisma/adapter-mariadb 7.3.0
// @index_tags prisma, mysql, schema, persistence, installation, contracts
// @author holic512

generator client {
  provider = "prisma-client"
  output   = "../../../generated/prisma-mysql"
}

datasource db {
  provider = "mysql"
}

model Session {
  id        String    @id @db.Char(36)
  userId    Int       @map("user_id")
  tokenHash String    @unique(map: "uq_auth_session_token_hash") @map("token_hash") @db.VarChar(128)
  createdAt DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  expiresAt DateTime  @map("expires_at") @db.DateTime(3)
  revokedAt DateTime? @map("revoked_at") @db.DateTime(3)
  ip        String?   @db.VarChar(255)
  userAgent String?   @map("user_agent") @db.Text
  User      User      @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([expiresAt], map: "idx_auth_session_expires_at")
  @@index([userId], map: "idx_auth_session_user_id")
  @@map("auth_session")
}

model User {
  id                     Int                 @id @default(autoincrement())
  username               String              @unique(map: "uq_auth_user_username") @db.VarChar(255)
  password               String              @db.VarChar(255)
  passwordConfigured     Boolean             @default(true) @map("password_configured")
  email                  String?             @unique(map: "uq_auth_user_email") @db.VarChar(255)
  displayName            String?             @map("display_name") @db.VarChar(80)
  avatar                 String?             @db.VarChar(500)
  bio                    String?             @db.Text
  role                   String              @default("USER") @db.VarChar(20)
  status                 Int                 @default(1) @db.SmallInt
  pointsBalance          Int                 @default(0) @map("points_balance")
  walletAddress          String?             @unique(map: "uq_auth_user_wallet_address") @map("wallet_address") @db.VarChar(64)
  lastLoginAt            DateTime?           @map("last_login_at") @db.DateTime(3)
  createdAt              DateTime            @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt              DateTime            @default(now()) @map("updated_at") @db.DateTime(3)
  Session                Session[]
  pointTransactions      PointTransaction[]
  createdGiftCardBatches GiftCardBatch[]     @relation("GiftCardBatchCreator")
  redeemedGiftCards      GiftCard[]          @relation("GiftCardRedemption")
  releaseCredentials     ReleaseCredential[] @relation("ReleaseCredentialIssuer")
  credentialAttempts     ReleaseCredentialAttempt[] @relation("ReleaseCredentialAttemptIssuer")
  issuedContracts       Contract[]          @relation("ContractIssuer")
  receivedContracts     Contract[]          @relation("ContractSubject")
  contractCredentials   ContractCredential[] @relation("ContractCredentialIssuer")
  contractCredentialAttempts ContractCredentialAttempt[] @relation("ContractCredentialAttemptIssuer")
  contractAdminAudits  ContractAdminAudit[] @relation("ContractAdminAuditActor")

  @@index([role, status], map: "idx_auth_user_role_status")
  @@map("auth_user")
}

model PointTransaction {
  id           Int      @id @default(autoincrement())
  userId       Int      @map("user_id")
  amount       Int
  balanceAfter Int      @map("balance_after")
  type         String   @db.VarChar(40)
  referenceId  String?  @map("reference_id") @db.VarChar(128)
  description  String?  @db.VarChar(255)
  createdAt    DateTime @default(now()) @map("created_at") @db.DateTime(3)
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([userId, createdAt], map: "idx_points_transaction_user_created")
  @@index([type, referenceId], map: "idx_points_transaction_reference")
  @@map("points_transaction")
}

model GiftCardBatch {
  id          Int        @id @default(autoincrement())
  name        String     @db.VarChar(128)
  points      Int
  quantity    Int
  expiresAt   DateTime?  @map("expires_at") @db.DateTime(3)
  status      Int        @default(1) @db.SmallInt
  createdById Int        @map("created_by_id")
  createdAt   DateTime   @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt   DateTime   @default(now()) @map("updated_at") @db.DateTime(3)
  createdBy   User       @relation("GiftCardBatchCreator", fields: [createdById], references: [id], onDelete: Restrict, onUpdate: NoAction)
  cards       GiftCard[]

  @@index([createdById], map: "idx_gift_card_batch_creator")
  @@index([status, expiresAt], map: "idx_gift_card_batch_status_expires")
  @@map("points_gift_card_batch")
}

model GiftCard {
  id           Int           @id @default(autoincrement())
  batchId      Int           @map("batch_id")
  codeHash     String        @unique(map: "uq_gift_card_code_hash") @map("code_hash") @db.VarChar(64)
  codeHint     String        @map("code_hint") @db.VarChar(24)
  status       Int           @default(1) @db.SmallInt
  redeemedById Int?          @map("redeemed_by_id")
  redeemedAt   DateTime?     @map("redeemed_at") @db.DateTime(3)
  createdAt    DateTime      @default(now()) @map("created_at") @db.DateTime(3)
  batch        GiftCardBatch @relation(fields: [batchId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  redeemedBy   User?         @relation("GiftCardRedemption", fields: [redeemedById], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@index([batchId, status], map: "idx_gift_card_batch_status")
  @@index([redeemedById], map: "idx_gift_card_redeemed_by")
  @@map("points_gift_card")
}

model Project {
  id          Int   @id @default(autoincrement())
  projectName String   @map("project_name") @db.VarChar(128)
  avatar      String?  @db.VarChar(500)
  weight      Int
  status      Int      @db.SmallInt
  requireAuth Boolean  @default(false) @map("require_auth")
  createdAt   DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt   DateTime @default(now()) @map("updated_at") @db.DateTime(3)
  isDeleted   Boolean  @default(false) @map("is_deleted")
  versions    ProjectVersion[]
  menus       ProjectMenu[]
  home        ProjectHome?

  @@map("collections_project")
}

model ProjectMenu {
  id         Int         @id @default(autoincrement())
  projectId  Int         @map("project_id")
  parentId   Int?        @map("parent_id")
  label      String         @db.VarChar(64)
  url        String?        @db.VarChar(2048)
  isExternal Boolean        @default(false) @map("is_external")
  weight     Int            @default(0)
  status     Int            @default(1) @db.SmallInt
  createdAt  DateTime       @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt  DateTime       @default(now()) @map("updated_at") @db.DateTime(3)
  isDeleted  Boolean        @default(false) @map("is_deleted")
  project    Project        @relation(fields: [projectId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  parent     ProjectMenu?   @relation("MenuHierarchy", fields: [parentId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  children   ProjectMenu[]  @relation("MenuHierarchy")

  @@index([projectId], map: "idx_collections_project_menu_project_id")
  @@index([parentId], map: "idx_collections_project_menu_parent_id")
  @@map("collections_project_menu")
}

model ProjectHome {
  id        Int   @id @default(autoincrement())
  projectId Int   @unique(map: "uq_collections_project_home_project_id") @map("project_id")
  content   String   @db.LongText
  status    Int      @default(1) @db.SmallInt
  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt DateTime @default(now()) @map("updated_at") @db.DateTime(3)
  isDeleted Boolean  @default(false) @map("is_deleted")
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([projectId], map: "idx_collections_project_home_project_id")
  @@map("collections_project_home")
}

model ProjectVersion {
  id               Int     @id @default(autoincrement())
  projectId        Int     @map("project_id")
  version          String     @db.VarChar(64)
  description      String?    @db.Text
  weight           Int
  status           Int        @db.SmallInt
  documentRevision Int        @default(0) @map("document_revision")
  releaseId        String?    @unique(map: "uq_collections_project_version_release_id") @map("release_id") @db.Char(36)
  releaseHash      String?    @unique(map: "uq_collections_project_version_release_hash") @map("release_hash") @db.Char(64)
  manifestVersion  Int?       @map("manifest_version")
  publishedAt      DateTime?  @map("published_at") @db.DateTime(3)
  createdAt        DateTime   @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt        DateTime   @default(now()) @map("updated_at") @db.DateTime(3)
  isDeleted        Boolean    @default(false) @map("is_deleted")
  project          Project    @relation(fields: [projectId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  categories       Category[]
  releaseCredentials ReleaseCredential[]

  @@index([projectId], map: "idx_collections_project_version_project_id")
  @@map("collections_project_version")
}

model Category {
  id               Int         @id @default(autoincrement())
  projectVersionId Int         @map("project_version_id")
  categoryName     String         @map("category_name") @db.VarChar(64)
  weight           Int
  status           Int            @db.SmallInt
  createdAt        DateTime       @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt        DateTime       @default(now()) @map("updated_at") @db.DateTime(3)
  isDeleted        Boolean        @default(false) @map("is_deleted")
  projectVersion   ProjectVersion @relation(fields: [projectVersionId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  noteInfos        NoteInfo[]

  @@index([projectVersionId], map: "idx_collections_category_project_version_id")
  @@map("collections_category")
}

model NoteInfo {
  id              Int        @id @default(autoincrement())
  categoryId      Int        @map("category_id")
  authorId        Int?       @map("author_id")
  noteTitle       String        @map("note_title") @db.VarChar(255)
  weight          Int
  status          Int           @db.SmallInt
  contentRevision Int           @default(0) @map("content_revision")
  createdAt       DateTime      @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt       DateTime      @default(now()) @map("updated_at") @db.DateTime(3)
  isDeleted       Boolean       @default(false) @map("is_deleted")
  category        Category      @relation(fields: [categoryId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  contents        NoteContent[]

  @@index([categoryId], map: "idx_docs_note_info_category_id")
  @@index([authorId], map: "idx_docs_note_info_author_id")
  @@map("docs_note_info")
}

model NoteContent {
  id          Int   @id @default(autoincrement())
  noteInfoId  Int   @map("note_info_id")
  content     String   @db.LongText
  versionNote String?  @map("version_note") @db.VarChar(255)
  isPrimary   Boolean  @default(false) @map("is_primary")
  status      Int      @db.SmallInt
  createdAt   DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt   DateTime @default(now()) @map("updated_at") @db.DateTime(3)
  isDeleted   Boolean  @default(false) @map("is_deleted")
  noteInfo    NoteInfo @relation(fields: [noteInfoId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([noteInfoId], map: "idx_docs_note_content_note_info_id")
  @@map("docs_note_content")
}

model FileManagement {
  id           Int   @id @default(autoincrement())
  originalName String   @map("original_name") @db.VarChar(255)
  fileName     String   @map("file_name") @db.VarChar(255)
  filePath     String   @map("file_path") @db.VarChar(500)
  fileSize     BigInt   @map("file_size") @db.BigInt
  businessType String   @map("business_type") @db.VarChar(50)
  status       Int      @default(1) @db.SmallInt
  createTime   DateTime @default(now()) @map("create_time") @db.DateTime(3)
  contractAttachment Contract? @relation("ContractAttachment")

  @@map("files_file_management")
}

model Contract {
  id               Int       @id @default(autoincrement())
  contractId       String    @unique(map: "uq_contract_contract_id") @map("contract_id") @db.Char(36)
  installationId   String?   @map("installation_id") @db.Char(36)
  issuerUserId     Int       @map("issuer_user_id")
  subjectUserId    Int       @map("subject_user_id")
  title            String    @db.VarChar(255)
  body             String    @db.LongText
  bodyHash         String    @map("body_hash") @db.Char(64)
  contractHash     String?   @map("contract_hash") @db.Char(64)
  attachmentFileId Int?      @unique(map: "uq_contract_attachment_file_id") @map("attachment_file_id")
  attachmentHash   String?   @map("attachment_hash") @db.Char(64)
  partyCommitment  String    @map("party_commitment") @db.Char(64)
  status           Int       @default(0) @db.SmallInt
  issuedAt         DateTime? @map("issued_at") @db.DateTime(3)
  signedAt         DateTime? @map("signed_at") @db.DateTime(3)
  signedSessionId  String?   @map("signed_session_id") @db.Char(36)
  signedIp         String?   @map("signed_ip") @db.VarChar(255)
  signedUserAgent  String?   @map("signed_user_agent") @db.Text
  declinedAt       DateTime? @map("declined_at") @db.DateTime(3)
  declineReason    String?   @map("decline_reason") @db.VarChar(500)
  cancelledAt      DateTime? @map("cancelled_at") @db.DateTime(3)
  createdAt        DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt        DateTime  @default(now()) @map("updated_at") @db.DateTime(3)
  issuerUser       User      @relation("ContractIssuer", fields: [issuerUserId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  subjectUser      User      @relation("ContractSubject", fields: [subjectUserId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  attachmentFile   FileManagement? @relation("ContractAttachment", fields: [attachmentFileId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  credentials      ContractCredential[]
  adminAudits      ContractAdminAudit[]

  @@index([subjectUserId, status], map: "idx_contract_subject_status")
  @@index([issuerUserId, createdAt], map: "idx_contract_issuer_created")
  @@map("contract")
}

model ContractAdminAudit {
  id          Int      @id @default(autoincrement())
  contractId  Int      @map("contract_id")
  actorUserId Int      @map("actor_user_id")
  action      String   @db.VarChar(64)
  createdAt   DateTime @default(now()) @map("created_at") @db.DateTime(3)
  contract    Contract @relation(fields: [contractId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  actorUser   User     @relation("ContractAdminAuditActor", fields: [actorUserId], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@index([contractId, createdAt], map: "idx_contract_admin_audit_contract_created")
  @@index([actorUserId, createdAt], map: "idx_contract_admin_audit_actor_created")
  @@map("contract_admin_audit")
}

model ContractCredential {
  id                   Int      @id @default(autoincrement())
  contractId           Int      @map("contract_id")
  issuerUserId         Int      @map("issuer_user_id")
  network              String   @db.VarChar(20)
  signerAddress        String   @map("signer_address") @db.VarChar(64)
  memo                 String   @db.Text
  transactionSignature String?  @unique(map: "uq_contract_credential_transaction_signature") @map("transaction_signature") @db.VarChar(128)
  status               Int      @default(0) @db.SmallInt
  slot                 BigInt?  @db.BigInt
  blockTime            DateTime? @map("block_time") @db.DateTime(3)
  feeLamports          BigInt?  @map("fee_lamports") @db.BigInt
  finalizedAt          DateTime? @map("finalized_at") @db.DateTime(3)
  lastVerifiedAt       DateTime? @map("last_verified_at") @db.DateTime(3)
  createdAt            DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt            DateTime @default(now()) @map("updated_at") @db.DateTime(3)
  contract             Contract @relation(fields: [contractId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  issuerUser           User     @relation("ContractCredentialIssuer", fields: [issuerUserId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  attempts             ContractCredentialAttempt[]

  @@unique([contractId, network], map: "uq_contract_credential_contract_network")
  @@index([network, status], map: "idx_contract_credential_network_status")
  @@index([signerAddress], map: "idx_contract_credential_signer")
  @@map("contract_credential")
}

model ContractCredentialAttempt {
  id                   Int      @id @default(autoincrement())
  credentialId         Int      @map("credential_id")
  issuerUserId         Int      @map("issuer_user_id")
  signerAddress        String   @map("signer_address") @db.VarChar(64)
  memo                 String   @db.Text
  messageHash          String   @map("message_hash") @db.Char(64)
  recentBlockhash      String   @map("recent_blockhash") @db.VarChar(100)
  lastValidBlockHeight BigInt   @map("last_valid_block_height") @db.BigInt
  transactionSignature String?  @map("transaction_signature") @db.VarChar(128)
  status               Int      @default(0) @db.SmallInt
  failureCode          String?  @map("failure_code") @db.VarChar(64)
  failureMessage       String?  @map("failure_message") @db.VarChar(500)
  expiresAt            DateTime @map("expires_at") @db.DateTime(3)
  submittedAt          DateTime? @map("submitted_at") @db.DateTime(3)
  finalizedAt          DateTime? @map("finalized_at") @db.DateTime(3)
  createdAt            DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt            DateTime @default(now()) @map("updated_at") @db.DateTime(3)
  credential           ContractCredential @relation(fields: [credentialId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  issuerUser           User     @relation("ContractCredentialAttemptIssuer", fields: [issuerUserId], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@index([credentialId, status], map: "idx_contract_credential_attempt_status")
  @@index([transactionSignature], map: "idx_contract_credential_attempt_signature")
  @@map("contract_credential_attempt")
}

model SystemConfig {
  id          Int   @id @default(autoincrement())
  configKey   String   @unique(map: "uq_system_config_key") @map("config_key") @db.VarChar(100)
  configValue String   @map("config_value") @db.VarChar(500)
  description String?  @db.VarChar(255)
  createdAt   DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt   DateTime @default(now()) @map("updated_at") @db.DateTime(3)

  @@map("system_config")
}

model SystemHomepage {
  id        Int   @id @default(autoincrement())
  content   String   @db.LongText
  status    Int      @default(1) @db.SmallInt
  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt DateTime @default(now()) @map("updated_at") @db.DateTime(3)
  isDeleted Boolean  @default(false) @map("is_deleted")

  @@map("system_homepage")
}

model SystemInstallation {
  id             Int       @id
  provider       String    @db.VarChar(20)
  status         String    @db.VarChar(32)
  schemaRevision Int       @map("schema_revision")
  installationId String    @unique(map: "uq_system_installation_id") @map("installation_id") @db.Char(36)
  createdAt      DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt      DateTime  @default(now()) @map("updated_at") @db.DateTime(3)
  installedAt    DateTime? @map("installed_at") @db.DateTime(3)

  @@map("system_installation")
}

model ReleaseCredential {
  id                   Int      @id @default(autoincrement())
  projectVersionId     Int      @map("project_version_id")
  issuerUserId         Int      @map("issuer_user_id")
  network              String   @db.VarChar(20)
  signerAddress        String   @map("signer_address") @db.VarChar(64)
  memo                 String   @db.Text
  transactionSignature String?  @unique(map: "uq_release_credential_transaction_signature") @map("transaction_signature") @db.VarChar(128)
  status               Int      @default(0) @db.SmallInt
  slot                  BigInt?  @db.BigInt
  blockTime             DateTime? @map("block_time") @db.DateTime(3)
  feeLamports           BigInt?  @map("fee_lamports") @db.BigInt
  finalizedAt           DateTime? @map("finalized_at") @db.DateTime(3)
  lastVerifiedAt        DateTime? @map("last_verified_at") @db.DateTime(3)
  createdAt             DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt             DateTime @default(now()) @map("updated_at") @db.DateTime(3)
  projectVersion        ProjectVersion @relation(fields: [projectVersionId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  issuerUser            User @relation("ReleaseCredentialIssuer", fields: [issuerUserId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  attempts              ReleaseCredentialAttempt[]

  @@unique([projectVersionId, network], map: "uq_release_credential_version_network")
  @@index([network, status], map: "idx_release_credential_network_status")
  @@index([signerAddress], map: "idx_release_credential_signer")
  @@map("release_credential")
}

model ReleaseCredentialAttempt {
  id                   Int      @id @default(autoincrement())
  credentialId         Int      @map("credential_id")
  issuerUserId         Int      @map("issuer_user_id")
  signerAddress        String   @map("signer_address") @db.VarChar(64)
  memo                 String   @db.Text
  messageHash          String   @map("message_hash") @db.Char(64)
  recentBlockhash      String   @map("recent_blockhash") @db.VarChar(100)
  lastValidBlockHeight BigInt   @map("last_valid_block_height") @db.BigInt
  transactionSignature String?  @map("transaction_signature") @db.VarChar(128)
  status               Int      @default(0) @db.SmallInt
  failureCode          String?  @map("failure_code") @db.VarChar(64)
  failureMessage       String?  @map("failure_message") @db.VarChar(500)
  expiresAt            DateTime @map("expires_at") @db.DateTime(3)
  submittedAt          DateTime? @map("submitted_at") @db.DateTime(3)
  finalizedAt          DateTime? @map("finalized_at") @db.DateTime(3)
  createdAt            DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt            DateTime @default(now()) @map("updated_at") @db.DateTime(3)
  credential           ReleaseCredential @relation(fields: [credentialId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  issuerUser            User @relation("ReleaseCredentialAttemptIssuer", fields: [issuerUserId], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@index([credentialId, status], map: "idx_release_credential_attempt_status")
  @@index([transactionSignature], map: "idx_release_credential_attempt_signature")
  @@map("release_credential_attempt")
}
