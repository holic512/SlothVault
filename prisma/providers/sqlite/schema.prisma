// @file prisma/providers/sqlite/schema.prisma
// @project SlothVault
// @module SQLite persistence model
// @description Defines the flat, domain-prefixed SQLite schema for independent articles, project publishing, multi-wallet user identity and monthly username quotas, revocable MCP API keys, contracts, commissioned development lifecycles, points, gift cards, transaction evidence, independent operator attribution, and account deletion history.
// @logic Keep authoritative per-address wallet relations and credential revisions aligned with the legacy projection; preserve the provider-neutral article, project, identity, and MCP key models for single-instance deployments and bind optional Solana evidence only to immutable project releases and frozen contracts.
// @dependencies Prisma ORM 7.10.1, @prisma/adapter-better-sqlite3 7.10.1
// @index_tags prisma, sqlite, schema, persistence, articles, projects, mcp, api-key, installation, contracts, wallet, credentials, username-quota
// @author holic512

generator client {
  provider = "prisma-client"
  output   = "../../../generated/prisma-sqlite"
}

datasource db {
  provider = "sqlite"
}

model Session {
  id        String    @id
  userId    Int       @map("user_id")
  tokenHash String    @unique(map: "uq_auth_session_token_hash") @map("token_hash")
  persistent Boolean @default(false)
  createdAt DateTime  @default(now()) @map("created_at")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  ip        String?
  userAgent String?   @map("user_agent")
  User      User      @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([expiresAt], map: "idx_auth_session_expires_at")
  @@index([userId], map: "idx_auth_session_user_id")
  @@map("auth_session")
}

model UserWallet {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  address   String   @unique(map: "uq_auth_user_wallet_address_binding")
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([userId, createdAt, id], map: "idx_auth_user_wallet_user_created")
  @@map("auth_user_wallet")
}

model User {
  authoredNotes NoteInfo[] @relation("NoteAuthor")
  id                     Int                 @id @default(autoincrement())
  username               String              @unique(map: "uq_auth_user_username")
  password               String
  passwordConfigured     Boolean             @default(true) @map("password_configured")
  usernameChangeMonth    String?             @map("username_change_month")
  usernameChangeCount    Int                 @default(0) @map("username_change_count")
  credentialsRevision    Int                 @default(0) @map("credentials_revision")
  wallets                UserWallet[]
  email                  String?             @unique(map: "uq_auth_user_email")
  displayName            String?             @map("display_name")
  avatar                 String?
  bio                    String?
  role                   String              @default("USER")
  status                 Int                 @default(1)
  pointsBalance          Int                 @default(0) @map("points_balance")
  walletAddress          String?             @unique(map: "uq_auth_user_wallet_address") @map("wallet_address")
  lastLoginAt            DateTime?           @map("last_login_at")
  createdAt              DateTime            @default(now()) @map("created_at")
  updatedAt              DateTime            @default(now()) @map("updated_at")
  Session                Session[]
  pointTransactions      PointTransaction[]
  membershipGrants       MembershipGrant[] @relation("MembershipGrantUser")
  grantedMembershipGrants MembershipGrant[] @relation("MembershipGrantGrantedBy")
  revokedMembershipGrants MembershipGrant[] @relation("MembershipGrantRevokedBy")
  releaseCredentials     ReleaseCredential[] @relation("ReleaseCredentialIssuer")
  credentialAttempts     ReleaseCredentialAttempt[] @relation("ReleaseCredentialAttemptIssuer")
  mcpApiKeys          McpApiKey[]

  @@index([role, status], map: "idx_auth_user_role_status")
  @@map("auth_user")
}

model McpApiKey {
  id         Int       @id @default(autoincrement())
  userId     Int       @map("user_id")
  publicId   String    @unique(map: "uq_mcp_api_key_public_id") @map("public_id")
  secretHash String    @map("secret_hash")
  name       String
  status     Int       @default(1)
  expiresAt  DateTime? @map("expires_at")
  lastUsedAt DateTime? @map("last_used_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @default(now()) @map("updated_at")
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([userId, status], map: "idx_mcp_api_key_user_status")
  @@index([status, expiresAt], map: "idx_mcp_api_key_status_expires")
  @@map("mcp_api_key")
}

model PointTransaction {
  attributionJson String @default("{}") @map("attribution_json")
  id           Int      @id @default(autoincrement())
  userId       Int      @map("user_id")
  amount       Int
  balanceAfter Int      @map("balance_after")
  type         String
  referenceId  String?  @map("reference_id")
  description  String?
  createdAt    DateTime @default(now()) @map("created_at")
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([userId, createdAt], map: "idx_points_transaction_user_created")
  @@index([type, referenceId], map: "idx_points_transaction_reference")
  @@map("points_transaction")
}

model Article {
  id                        Int              @id @default(autoincrement())
  title                     String
  summary                   String?
  cover                     String?
  content                   String
  status                    Int              @default(0)
  requiredMembershipLevelId Int?             @map("required_membership_level_id")
  publishedAt               DateTime?        @map("published_at")
  createdAt                 DateTime         @default(now()) @map("created_at")
  updatedAt                 DateTime         @default(now()) @map("updated_at")
  isDeleted                 Boolean          @default(false) @map("is_deleted")
  deletedAt                 DateTime?        @map("deleted_at")
  allowedMemberships        ArticleMembership[]
  requiredMembershipLevel   MembershipLevel? @relation("ArticleRequiredMembershipLevel", fields: [requiredMembershipLevelId], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@index([status, isDeleted, publishedAt], map: "idx_blog_article_public")
  @@index([requiredMembershipLevelId], map: "idx_blog_article_required_membership_level")
  @@map("blog_article")
}

model MembershipLevel {
  id               Int               @id @default(autoincrement())
  name             String
  rank             Int               @unique(map: "uq_membership_level_rank")
  pricePoints      Int               @map("price_points")
  validityDays     Int?              @map("validity_days")
  status           Int               @default(1)
  createdAt        DateTime          @default(now()) @map("created_at")
  updatedAt        DateTime          @default(now()) @map("updated_at")
  grants           MembershipGrant[]
  articleMemberships ArticleMembership[]
  readableProjects ProjectReadMembership[]
  downloadableProjects ProjectDownloadMembership[]
  requiredArticles Article[]         @relation("ArticleRequiredMembershipLevel")

  @@index([status, rank], map: "idx_membership_level_status_rank")
  @@map("membership_level")
}

model MembershipGrant {
  attributionJson String @default("{}") @map("attribution_json")
  id                Int             @id @default(autoincrement())
  userId            Int             @map("user_id")
  membershipLevelId Int             @map("membership_level_id")
  source            String
  pointsCost        Int?            @map("points_cost")
  grantedByUserId   Int?            @map("granted_by_user_id")
  grantedAt         DateTime        @default(now()) @map("granted_at")
  expiresAt         DateTime?       @map("expires_at")
  revokedAt         DateTime?       @map("revoked_at")
  revokedByUserId   Int?            @map("revoked_by_user_id")
  user              User            @relation("MembershipGrantUser", fields: [userId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  membershipLevel   MembershipLevel @relation(fields: [membershipLevelId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  grantedByUser     User?           @relation("MembershipGrantGrantedBy", fields: [grantedByUserId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  revokedByUser     User?           @relation("MembershipGrantRevokedBy", fields: [revokedByUserId], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@index([userId, revokedAt, expiresAt], map: "idx_membership_grant_user_active")
  @@index([membershipLevelId], map: "idx_membership_grant_level")
  @@map("membership_grant")
}

model Project {
  id          Int   @id @default(autoincrement())
  projectName String   @map("project_name")
  avatar      String?
  weight      Int
  status      Int
  readAccessMode String @default("PUBLIC") @map("read_access_mode")
  downloadAccessMode String @default("FOLLOW_READ") @map("download_access_mode")
  readMemberships ProjectReadMembership[]
  downloadMemberships ProjectDownloadMembership[]
  fileReferences FileReference[]
  requireAuth Boolean  @default(false) @map("require_auth")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @default(now()) @map("updated_at")
  isDeleted   Boolean  @default(false) @map("is_deleted")
  deletedAt   DateTime? @map("deleted_at")
  versions    ProjectVersion[]
  menus       ProjectMenu[]
  home        ProjectHome?

  @@map("collections_project")
}

model ProjectMenu {
  id         Int         @id @default(autoincrement())
  projectId  Int         @map("project_id")
  parentId   Int?        @map("parent_id")
  label      String
  icon       String?
  url        String?
  isExternal Boolean        @default(false) @map("is_external")
  weight     Int            @default(0)
  status     Int            @default(1)
  createdAt  DateTime       @default(now()) @map("created_at")
  updatedAt  DateTime       @default(now()) @map("updated_at")
  isDeleted  Boolean        @default(false) @map("is_deleted")
  deletedAt  DateTime?      @map("deleted_at")
  project    Project        @relation(fields: [projectId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  parent     ProjectMenu?   @relation("MenuHierarchy", fields: [parentId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  children   ProjectMenu[]  @relation("MenuHierarchy")

  @@index([projectId], map: "idx_collections_project_menu_project_id")
  @@index([parentId], map: "idx_collections_project_menu_parent_id")
  @@map("collections_project_menu")
}

model ProjectHome {
  id        Int   @id @default(autoincrement())
  projectId Int   @unique(map: "uq_collections_project_home_project_id") @map("project_id")
  content   String
  status    Int      @default(1)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @map("updated_at")
  isDeleted Boolean  @default(false) @map("is_deleted")
  deletedAt DateTime? @map("deleted_at")
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([projectId], map: "idx_collections_project_home_project_id")
  @@map("collections_project_home")
}

model ProjectVersion {
  id               Int     @id @default(autoincrement())
  projectId        Int     @map("project_id")
  version          String
  description      String?
  weight           Int
  status           Int
  documentRevision Int       @default(0) @map("document_revision")
  documentationStateJson String? @map("documentation_state_json")
  releaseId        String?   @unique(map: "uq_collections_project_version_release_id") @map("release_id")
  releaseHash      String?   @map("release_hash")
  releaseManifestJson String? @map("release_manifest_json")
  manifestVersion  Int?      @map("manifest_version")
  publishedAt      DateTime? @map("published_at")
  createdAt        DateTime   @default(now()) @map("created_at")
  updatedAt        DateTime   @default(now()) @map("updated_at")
  isDeleted        Boolean    @default(false) @map("is_deleted")
  deletedAt        DateTime?   @map("deleted_at")
  project          Project    @relation(fields: [projectId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  categories       Category[]
  releaseCredentials ReleaseCredential[]

  @@index([projectId], map: "idx_collections_project_version_project_id")
  @@map("collections_project_version")
}

model Category {
  id               Int         @id @default(autoincrement())
  projectVersionId Int         @map("project_version_id")
  categoryName     String         @map("category_name")
  weight           Int
  status           Int
  createdAt        DateTime       @default(now()) @map("created_at")
  updatedAt        DateTime       @default(now()) @map("updated_at")
  isDeleted        Boolean        @default(false) @map("is_deleted")
  deletedAt        DateTime?      @map("deleted_at")
  projectVersion   ProjectVersion @relation(fields: [projectVersionId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  noteInfos        NoteInfo[]

  @@index([projectVersionId], map: "idx_collections_category_project_version_id")
  @@map("collections_category")
}

model NoteInfo {
  author User? @relation("NoteAuthor", fields: [authorId], references: [id], onDelete: SetNull, onUpdate: NoAction)

  attributionJson String @default("{}") @map("attribution_json")
  id              Int        @id @default(autoincrement())
  categoryId      Int        @map("category_id")
  authorId        Int?       @map("author_id")
  noteTitle       String        @map("note_title")
  tagsJson        String?       @map("tags_json")
  weight          Int
  status          Int
  contentRevision Int           @default(0) @map("content_revision")
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @default(now()) @map("updated_at")
  isDeleted       Boolean       @default(false) @map("is_deleted")
  deletedAt       DateTime?     @map("deleted_at")
  category        Category      @relation(fields: [categoryId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  contents        NoteContent[]

  @@index([categoryId], map: "idx_docs_note_info_category_id")
  @@index([authorId], map: "idx_docs_note_info_author_id")
  @@map("docs_note_info")
}

model NoteContent {
  id          Int   @id @default(autoincrement())
  noteInfoId  Int   @map("note_info_id")
  evidenceId  String?  @unique(map: "uq_docs_note_content_evidence_id") @map("evidence_id")
  content     String
  versionNote String?  @map("version_note")
  isPrimary   Boolean  @default(false) @map("is_primary")
  status      Int
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @default(now()) @map("updated_at")
  isDeleted   Boolean  @default(false) @map("is_deleted")
  deletedAt   DateTime? @map("deleted_at")
  noteInfo    NoteInfo @relation(fields: [noteInfoId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  releaseCredentials ReleaseCredential[]

  @@index([noteInfoId], map: "idx_docs_note_content_note_info_id")
  @@map("docs_note_content")
}

model FileManagement {
  id           Int   @id @default(autoincrement())
  originalName String   @map("original_name")
  fileName     String   @map("file_name")
  filePath     String   @map("file_path")
  fileSize     BigInt   @map("file_size")
  businessType String   @map("business_type")
  status       Int      @default(1)
  createTime   DateTime @default(now()) @map("create_time")
  references   FileReference[]

  @@map("files_file_management")
}

model SystemConfig {
  id          Int   @id @default(autoincrement())
  configKey   String   @unique(map: "uq_system_config_key") @map("config_key")
  configValue String   @map("config_value")
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @default(now()) @map("updated_at")

  @@map("system_config")
}

model SystemHomepage {
  id        Int   @id @default(autoincrement())
  content   String
  status    Int      @default(1)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @map("updated_at")
  isDeleted Boolean  @default(false) @map("is_deleted")

  @@map("system_homepage")
}

model SystemInstallation {
  id             Int       @id
  provider       String
  status         String
  schemaRevision Int       @map("schema_revision")
  installationId String    @unique(map: "uq_system_installation_id") @map("installation_id")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @default(now()) @map("updated_at")
  installedAt    DateTime? @map("installed_at")

  @@map("system_installation")
}

model ReleaseCredential {
  attributionJson String @default("{}") @map("attribution_json")
  id                   Int      @id @default(autoincrement())
  projectVersionId     Int      @map("project_version_id")
  noteContentId        Int?     @map("note_content_id")
  issuerUserId         Int?      @map("issuer_user_id")
  subjectType          String   @default("PROJECT_VERSION") @map("subject_type")
  subjectId            String   @map("subject_id")
  subjectHash          String   @map("subject_hash")
  subjectManifestVersion Int    @map("subject_manifest_version")
  network              String
  signerAddress        String   @map("signer_address")
  memo                 String
  transactionSignature String?  @unique(map: "uq_release_credential_transaction_signature") @map("transaction_signature")
  status               Int      @default(0)
  slot                  BigInt?
  blockTime             DateTime? @map("block_time")
  feeLamports           BigInt?  @map("fee_lamports")
  finalizedAt           DateTime? @map("finalized_at")
  lastVerifiedAt        DateTime? @map("last_verified_at")
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @default(now()) @map("updated_at")
  projectVersion        ProjectVersion @relation(fields: [projectVersionId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  noteContent           NoteContent? @relation(fields: [noteContentId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  issuerUser            User? @relation("ReleaseCredentialIssuer", fields: [issuerUserId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  attempts              ReleaseCredentialAttempt[]

  @@unique([subjectType, subjectId, network], map: "uq_release_credential_subject_network")
  @@index([noteContentId], map: "idx_release_credential_note_content")
  @@index([network, status], map: "idx_release_credential_network_status")
  @@index([signerAddress], map: "idx_release_credential_signer")
  @@map("release_credential")
}

model ReleaseCredentialAttempt {
  attributionJson String @default("{}") @map("attribution_json")
  id                   Int      @id @default(autoincrement())
  credentialId         Int      @map("credential_id")
  issuerUserId         Int?      @map("issuer_user_id")
  signerAddress        String   @map("signer_address")
  memo                 String
  messageHash          String   @map("message_hash")
  recentBlockhash      String   @map("recent_blockhash")
  lastValidBlockHeight BigInt   @map("last_valid_block_height")
  transactionSignature String?  @map("transaction_signature")
  status               Int      @default(0)
  failureCode          String?  @map("failure_code")
  failureMessage       String?  @map("failure_message")
  expiresAt            DateTime @map("expires_at")
  submittedAt          DateTime? @map("submitted_at")
  finalizedAt          DateTime? @map("finalized_at")
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @default(now()) @map("updated_at")
  credential           ReleaseCredential @relation(fields: [credentialId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  issuerUser            User? @relation("ReleaseCredentialAttemptIssuer", fields: [issuerUserId], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@index([credentialId, status], map: "idx_release_credential_attempt_status")
  @@index([transactionSignature], map: "idx_release_credential_attempt_signature")
  @@map("release_credential_attempt")
}

model ArticleMembership {
  articleId Int @map("article_id")
  membershipLevelId Int @map("membership_level_id")
  article Article @relation(fields: [articleId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  membershipLevel MembershipLevel @relation(fields: [membershipLevelId], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@id([articleId, membershipLevelId])
  @@index([membershipLevelId], map: "idx_article_membership_level")
  @@map("article_membership")
}

model ProjectReadMembership {
  projectId Int @map("project_id")
  membershipLevelId Int @map("membership_level_id")
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  membershipLevel MembershipLevel @relation(fields: [membershipLevelId], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@id([projectId, membershipLevelId])
  @@index([membershipLevelId], map: "idx_project_read_membership_level")
  @@map("project_read_membership")
}

model ProjectDownloadMembership {
  projectId Int @map("project_id")
  membershipLevelId Int @map("membership_level_id")
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  membershipLevel MembershipLevel @relation(fields: [membershipLevelId], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@id([projectId, membershipLevelId])
  @@index([membershipLevelId], map: "idx_project_download_membership_level")
  @@map("project_download_membership")
}

model FileReference {
  id Int @id @default(autoincrement())
  fileId Int @map("file_id")
  sourceType String @map("source_type")
  sourceId Int @map("source_id")
  projectId Int? @map("project_id")
  usage String
  file FileManagement @relation(fields: [fileId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  project Project? @relation(fields: [projectId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([fileId, sourceType, sourceId, usage], map: "uq_file_reference_source_usage")
  @@index([sourceType, sourceId], map: "idx_file_reference_source")
  @@index([projectId], map: "idx_file_reference_project")
  @@map("files_file_reference")
}

model UserDeletionRecord {
  id Int @id @default(autoincrement())
  publicId String @unique(map: "uq_auth_user_deletion_public_id") @map("public_id")
  username String
  userSnapshotJson String @map("user_snapshot_json")
  actorSnapshotJson String @map("actor_snapshot_json")
  summaryJson String @map("summary_json")
  userCreatedAt DateTime @map("user_created_at")
  deletedAt DateTime @default(now()) @map("deleted_at")

  @@index([deletedAt], map: "idx_auth_user_deletion_deleted_at")
  @@map("auth_user_deletion_record")
}

model PluginInstallation {
  id Int @id @default(autoincrement())
  pluginId String @unique @map("plugin_id")
  version String
  digest String
  manifestJson String @map("manifest_json")
  configCiphertext String @default("") @map("config_ciphertext")
  accessBindingsJson String @default("{}") @map("access_bindings_json")
  installed Boolean @default(true)
  enabled Boolean @default(false)
  generation Int @default(1)
  source String?
  error String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @map("updated_at")
  @@map("plugin_installation")
}

model PluginPackage {
  id Int @id @default(autoincrement())
  pluginId String @map("plugin_id")
  version String
  digest String @unique
  manifestJson String @map("manifest_json")
  createdAt DateTime @default(now()) @map("created_at")
  @@map("plugin_package")
}

model PluginOwnedTable {
  id Int @id @default(autoincrement())
  pluginId String @map("plugin_id")
  name String @unique
  descriptorJson String @map("descriptor_json")
  @@map("plugin_owned_table")
}

model PluginMigration {
  id Int @id @default(autoincrement())
  pluginId String @map("plugin_id")
  key String
  digest String
  createdAt DateTime @default(now()) @map("created_at")
  @@unique([pluginId, key])
  @@map("plugin_migration")
}

model PluginOperation {
  id Int @id @default(autoincrement())
  pluginId String @map("plugin_id")
  action String
  status String @default("RUNNING")
  phase String
  payloadJson String @default("{}") @map("payload_json")
  error String?
  actorUserId Int? @map("actor_user_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @map("updated_at")
  @@map("plugin_operation")
}

model PluginTask {
  id Int @id @default(autoincrement())
  pluginId String @map("plugin_id")
  taskKey String @unique @map("task_key")
  kind String
  handler String
  payloadJson String @default("null") @map("payload_json")
  status String @default("PENDING")
  attempts Int @default(0)
  runAt DateTime @map("run_at")
  error String?
  createdAt DateTime @default(now()) @map("created_at")
  @@index([status, runAt])
  @@map("plugin_task")
}

model PluginPointReceipt {
  id Int @id @default(autoincrement())
  pluginId String @map("plugin_id")
  sourceKey String @map("source_key")
  userId Int? @map("user_id")
  amount Int
  balanceAfter Int @map("balance_after")
  createdAt DateTime @default(now()) @map("created_at")
  @@unique([pluginId, sourceKey])
  @@map("plugin_point_receipt")
}
