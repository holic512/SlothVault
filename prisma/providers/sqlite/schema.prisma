model Commission {
  id Int @id @default(autoincrement())
  commissionId String @unique(map: "uq_commission_identity") @map("commission_id")
  subjectUserId Int @map("subject_user_id")
  title String
  purpose String
  requirements String
  partyAJson String @default("{}") @map("party_a_json")
  partyBJson String @default("{}") @map("party_b_json")
  quotationFen BigInt? @map("quotation_fen")
  agreementFen BigInt? @map("agreement_fen")
  stage String @default("ASSESSMENT")
  progress Int @default(0)
  progressNote String @default("") @map("progress_note")
  revision Int @default(0)
  expectedDeliveryAt DateTime? @map("expected_delivery_at")
  startedAt DateTime? @map("started_at")
  acceptedAt DateTime? @map("accepted_at")
  adjustmentDays Int @default(15) @map("adjustment_days")
  maintenanceDays Int @default(30) @map("maintenance_days")
  settlementJson String @default("{}") @map("settlement_json")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @map("updated_at")
  subjectUser User @relation(fields: [subjectUserId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  contracts Contract[]
  milestones CommissionMilestone[]
  plans CommissionPaymentPlan[]
  payments CommissionPayment[]
  changes CommissionChange[]
  issues CommissionIssue[]
  deliveries CommissionDelivery[]
  acceptances CommissionAcceptance[]
  files CommissionFile[]
  events CommissionEvent[]
  @@index([subjectUserId, stage], map: "idx_commission_subject_stage")
  @@map("commission")
}

