// @file prisma/providers/postgresql/schema.prisma
// @project SlothVault
// @module PostgreSQL persistence model
// @description Defines the flat, domain-prefixed PostgreSQL schema for independent articles, project publishing, multi-wallet user identity and monthly username quotas, revocable MCP API keys, contracts, commissioned development lifecycles, points, gift cards, transaction evidence, independent operator attribution, and account deletion history.
// @logic Keep authoritative per-address wallet relations and credential revisions aligned with the legacy projection; preserve the provider-neutral article, project, identity, and MCP key models while applying PostgreSQL-native types and binding optional Solana evidence only to immutable project releases and frozen contracts.
// @dependencies Prisma ORM 7.10.1, @prisma/adapter-pg 7.10.1
// @index_tags prisma, postgresql, schema, persistence, articles, projects, mcp, api-key, installation, contracts, wallet, credentials, username-quota
// @author holic512

generator client {
  provider = "prisma-client"
  output   = "../../../generated/prisma-postgresql"
}

datasource db {
  provider = "postgresql"
}

model Session {
  id        String    @id @db.Uuid
  userId    Int       @map("user_id")
  tokenHash String    @unique(map: "uq_auth_session_token_hash") @map("token_hash") @db.VarChar(128)
  persistent Boolean @default(false)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(3)
  ip        String?   @db.VarChar(255)
  userAgent String?   @map("user_agent") @db.Text
  User      User      @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([expiresAt], map: "idx_auth_session_expires_at")
  @@index([userId], map: "idx_auth_session_user_id")
  @@map("auth_session")
}

model UserWallet {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  address   String   @unique(map: "uq_auth_user_wallet_address_binding") @db.VarChar(64)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([userId, createdAt, id], map: "idx_auth_user_wallet_user_created")
  @@map("auth_user_wallet")
}

model User {
  authoredNotes NoteInfo[] @relation("NoteAuthor")
  id                     Int                 @id @default(autoincrement())
  username               String              @unique(map: "uq_auth_user_username") @db.VarChar(255)
  password               String              @db.VarChar(255)
  passwordConfigured     Boolean             @default(true) @map("password_configured")
  usernameChangeMonth    String?             @map("username_change_month") @db.VarChar(7)
  usernameChangeCount    Int                 @default(0) @map("username_change_count")
  credentialsRevision    Int                 @default(0) @map("credentials_revision")
  wallets                UserWallet[]
  email                  String?             @unique(map: "uq_auth_user_email") @db.VarChar(255)
  displayName            String?             @map("display_name") @db.VarChar(80)
  avatar                 String?             @db.VarChar(500)
  bio                    String?             @db.Text
  role                   String              @default("USER") @db.VarChar(20)
  status                 Int                 @default(1) @db.SmallInt
  pointsBalance          Int                 @default(0) @map("points_balance")
  walletAddress          String?             @unique(map: "uq_auth_user_wallet_address") @map("wallet_address") @db.VarChar(64)
  lastLoginAt            DateTime?           @map("last_login_at") @db.Timestamptz(3)
  createdAt              DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt              DateTime            @default(now()) @map("updated_at") @db.Timestamptz(3)
  Session                Session[]
  pointTransactions      PointTransaction[]
  membershipGrants       MembershipGrant[] @relation("MembershipGrantUser")
  grantedMembershipGrants MembershipGrant[] @relation("MembershipGrantGrantedBy")
  revokedMembershipGrants MembershipGrant[] @relation("MembershipGrantRevokedBy")
  releaseCredentials     ReleaseCredential[] @relation("ReleaseCredentialIssuer")
  credentialAttempts     ReleaseCredentialAttempt[] @relation("ReleaseCredentialAttemptIssuer")
  mcpApiKeys          McpApiKey[]

  @@index([role, status], map: "idx_auth_user_role_status")
  @@map("auth_user")
}

model McpApiKey {
  id         Int       @id @default(autoincrement())
  userId     Int       @map("user_id")
  publicId   String    @unique(map: "uq_mcp_api_key_public_id") @map("public_id") @db.VarChar(32)
  secretHash String    @map("secret_hash") @db.VarChar(255)
  name       String    @db.VarChar(80)
  status     Int       @default(1) @db.SmallInt
  expiresAt  DateTime? @map("expires_at") @db.Timestamptz(3)
  lastUsedAt DateTime? @map("last_used_at") @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime  @default(now()) @map("updated_at") @db.Timestamptz(3)
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([userId, status], map: "idx_mcp_api_key_user_status")
  @@index([status, expiresAt], map: "idx_mcp_api_key_status_expires")
  @@map("mcp_api_key")
}

model PointTransaction {
  attributionJson String @default("{}") @map("attribution_json")
  id           Int      @id @default(autoincrement())
  userId       Int      @map("user_id")
  amount       Int
  balanceAfter Int      @map("balance_after")
  type         String   @db.VarChar(40)
  referenceId  String?  @map("reference_id") @db.VarChar(128)
  description  String?  @db.VarChar(255)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([userId, createdAt], map: "idx_points_transaction_user_created")
  @@index([type, referenceId], map: "idx_points_transaction_reference")
  @@map("points_transaction")
}

model Article {
  publicId String @default(uuid(4)) @unique(map: "uq_blog_article_public_id") @map("public_id") @db.VarChar(36)
  legacyUrlId Int? @unique(map: "uq_blog_article_legacy_url_id") @map("legacy_url_id")
  id                        Int              @id @default(autoincrement())
  title                     String           @db.VarChar(255)
  summary                   String?          @db.VarChar(500)
  cover                     String?          @db.VarChar(500)
  content                   String           @db.Text
  status                    Int              @default(0) @db.SmallInt
  requiredMembershipLevelId Int?             @map("required_membership_level_id")
  publishedAt               DateTime?        @map("published_at") @db.Timestamptz(3)
  createdAt                 DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                 DateTime         @default(now()) @map("updated_at") @db.Timestamptz(3)
  isDeleted                 Boolean          @default(false) @map("is_deleted")
  deletedAt                 DateTime?        @map("deleted_at")
  allowedMemberships        ArticleMembership[]
  requiredMembershipLevel   MembershipLevel? @relation("ArticleRequiredMembershipLevel", fields: [requiredMembershipLevelId], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@index([status, isDeleted, publishedAt], map: "idx_blog_article_public")
  @@index([requiredMembershipLevelId], map: "idx_blog_article_required_membership_level")
  @@map("blog_article")
}

model MembershipLevel {
  id               Int               @id @default(autoincrement())
  name             String            @db.VarChar(80)
  rank             Int               @unique(map: "uq_membership_level_rank") @db.SmallInt
  pricePoints      Int               @map("price_points")
  validityDays     Int?              @map("validity_days")
  status           Int               @default(1) @db.SmallInt
  createdAt        DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime          @default(now()) @map("updated_at") @db.Timestamptz(3)
  grants           MembershipGrant[]
  articleMemberships ArticleMembership[]
  readableProjects ProjectReadMembership[]
  downloadableProjects ProjectDownloadMembership[]
  requiredArticles Article[]         @relation("ArticleRequiredMembershipLevel")

  @@index([status, rank], map: "idx_membership_level_status_rank")
  @@map("membership_level")
}

model MembershipGrant {
  attributionJson String @default("{}") @map("attribution_json")
  id                Int             @id @default(autoincrement())
  userId            Int             @map("user_id")
  membershipLevelId Int             @map("membership_level_id")
  source            String          @db.VarChar(32)
  pointsCost        Int?            @map("points_cost")
  grantedByUserId   Int?            @map("granted_by_user_id")
  grantedAt         DateTime        @default(now()) @map("granted_at") @db.Timestamptz(3)
  expiresAt         DateTime?       @map("expires_at") @db.Timestamptz(3)
  revokedAt         DateTime?       @map("revoked_at") @db.Timestamptz(3)
  revokedByUserId   Int?            @map("revoked_by_user_id")
  user              User            @relation("MembershipGrantUser", fields: [userId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  membershipLevel   MembershipLevel @relation(fields: [membershipLevelId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  grantedByUser     User?           @relation("MembershipGrantGrantedBy", fields: [grantedByUserId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  revokedByUser     User?           @relation("MembershipGrantRevokedBy", fields: [revokedByUserId], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@index([userId, revokedAt, expiresAt], map: "idx_membership_grant_user_active")
  @@index([membershipLevelId], map: "idx_membership_grant_level")
  @@map("membership_grant")
}

model Project {
  publicId String @default(uuid(4)) @unique(map: "uq_collections_project_public_id") @map("public_id") @db.VarChar(36)
  legacyUrlId Int? @unique(map: "uq_collections_project_legacy_url_id") @map("legacy_url_id")
  id          Int   @id @default(autoincrement())
  projectName String   @map("project_name") @db.VarChar(128)
  avatar      String?  @db.VarChar(500)
  weight      Int
  status      Int      @db.SmallInt
  readAccessMode String @default("PUBLIC") @map("read_access_mode") @db.VarChar(32)
  downloadAccessMode String @default("FOLLOW_READ") @map("download_access_mode") @db.VarChar(32)
  readMemberships ProjectReadMembership[]
  downloadMemberships ProjectDownloadMembership[]
  fileReferences FileReference[]
  requireAuth Boolean  @default(false) @map("require_auth")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @default(now()) @map("updated_at") @db.Timestamptz(3)
  isDeleted   Boolean  @default(false) @map("is_deleted")
  deletedAt   DateTime? @map("deleted_at")
  versions    ProjectVersion[]
  menus       ProjectMenu[]
  home        ProjectHome?

  @@map("collections_project")
}

model ProjectMenu {
  id         Int         @id @default(autoincrement())
  projectId  Int         @map("project_id")
  parentId   Int?        @map("parent_id")
  label      String         @db.VarChar(64)
  icon       String?        @db.VarChar(64)
  url        String?        @db.VarChar(2048)
  isExternal Boolean        @default(false) @map("is_external")
  weight     Int            @default(0)
  status     Int            @default(1) @db.SmallInt
  createdAt  DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime       @default(now()) @map("updated_at") @db.Timestamptz(3)
  isDeleted  Boolean        @default(false) @map("is_deleted")
  deletedAt  DateTime?      @map("deleted_at")
  project    Project        @relation(fields: [projectId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  parent     ProjectMenu?   @relation("MenuHierarchy", fields: [parentId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  children   ProjectMenu[]  @relation("MenuHierarchy")

  @@index([projectId], map: "idx_collections_project_menu_project_id")
  @@index([parentId], map: "idx_collections_project_menu_parent_id")
  @@map("collections_project_menu")
}

model ProjectHome {
  id        Int   @id @default(autoincrement())
  projectId Int   @unique(map: "uq_collections_project_home_project_id") @map("project_id")
  content   String   @db.Text
  status    Int      @default(1) @db.SmallInt
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz(3)
  isDeleted Boolean  @default(false) @map("is_deleted")
  deletedAt DateTime? @map("deleted_at")
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([projectId], map: "idx_collections_project_home_project_id")
  @@map("collections_project_home")
}

model ProjectVersion {
  publicId String @default(uuid(4)) @unique(map: "uq_collections_project_version_public_id") @map("public_id") @db.VarChar(36)
  legacyUrlId Int? @unique(map: "uq_collections_project_version_legacy_url_id") @map("legacy_url_id")
  id               Int     @id @default(autoincrement())
  projectId        Int     @map("project_id")
  version          String     @db.VarChar(64)
  description      String?    @db.Text
  weight           Int
  status           Int        @db.SmallInt
  documentRevision Int        @default(0) @map("document_revision")
  documentationStateJson String? @map("documentation_state_json")
  releaseId        String?    @unique(map: "uq_collections_project_version_release_id") @map("release_id") @db.VarChar(36)
  releaseHash      String?    @map("release_hash") @db.Char(64)
  releaseManifestJson String? @map("release_manifest_json") @db.Text
  manifestVersion  Int?       @map("manifest_version")
  publishedAt      DateTime?  @map("published_at") @db.Timestamptz(3)
  createdAt        DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime   @default(now()) @map("updated_at") @db.Timestamptz(3)
  isDeleted        Boolean    @default(false) @map("is_deleted")
  deletedAt        DateTime?   @map("deleted_at")
  project          Project    @relation(fields: [projectId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  categories       Category[]
  releaseCredentials ReleaseCredential[]

  @@index([projectId], map: "idx_collections_project_version_project_id")
  @@map("collections_project_version")
}

model Category {
  id               Int         @id @default(autoincrement())
  projectVersionId Int         @map("project_version_id")
  categoryName     String         @map("category_name") @db.VarChar(64)
  weight           Int
  status           Int            @db.SmallInt
  createdAt        DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime       @default(now()) @map("updated_at") @db.Timestamptz(3)
  isDeleted        Boolean        @default(false) @map("is_deleted")
  deletedAt        DateTime?      @map("deleted_at")
  projectVersion   ProjectVersion @relation(fields: [projectVersionId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  noteInfos        NoteInfo[]

  @@index([projectVersionId], map: "idx_collections_category_project_version_id")
  @@map("collections_category")
}

model NoteInfo {
  publicId String @default(uuid(4)) @unique(map: "uq_docs_note_info_public_id") @map("public_id") @db.VarChar(36)
  legacyUrlId Int? @unique(map: "uq_docs_note_info_legacy_url_id") @map("legacy_url_id")
  author User? @relation("NoteAuthor", fields: [authorId], references: [id], onDelete: SetNull, onUpdate: NoAction)

  attributionJson String @default("{}") @map("attribution_json")
  id              Int        @id @default(autoincrement())
  categoryId      Int        @map("category_id")
  authorId        Int?       @map("author_id")
  noteTitle       String        @map("note_title") @db.VarChar(255)
  tagsJson        String?       @map("tags_json") @db.Text
  weight          Int
  status          Int           @db.SmallInt
  contentRevision Int           @default(0) @map("content_revision")
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime      @default(now()) @map("updated_at") @db.Timestamptz(3)
  isDeleted       Boolean       @default(false) @map("is_deleted")
  deletedAt       DateTime?     @map("deleted_at")
  category        Category      @relation(fields: [categoryId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  contents        NoteContent[]

  @@index([categoryId], map: "idx_docs_note_info_category_id")
  @@index([authorId], map: "idx_docs_note_info_author_id")
  @@map("docs_note_info")
}

model NoteContent {
  id          Int   @id @default(autoincrement())
  noteInfoId  Int   @map("note_info_id")
  evidenceId  String?  @unique(map: "uq_docs_note_content_evidence_id") @map("evidence_id") @db.Uuid
  content     String   @db.Text
  versionNote String?  @map("version_note") @db.VarChar(255)
  isPrimary   Boolean  @default(false) @map("is_primary")
  status      Int      @db.SmallInt
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @default(now()) @map("updated_at") @db.Timestamptz(3)
  isDeleted   Boolean  @default(false) @map("is_deleted")
  deletedAt   DateTime? @map("deleted_at")
  noteInfo    NoteInfo @relation(fields: [noteInfoId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  releaseCredentials ReleaseCredential[]

  @@index([noteInfoId], map: "idx_docs_note_content_note_info_id")
  @@map("docs_note_content")
}

model FileManagement {
  id           Int   @id @default(autoincrement())
  originalName String   @map("original_name") @db.VarChar(255)
  fileName     String   @map("file_name") @db.VarChar(255)
  filePath     String   @map("file_path") @db.VarChar(500)
  fileSize     BigInt   @map("file_size") @db.BigInt
  businessType String   @map("business_type") @db.VarChar(50)
  status       Int      @default(1) @db.SmallInt
  createTime   DateTime @default(now()) @map("create_time") @db.Timestamptz(3)
  references   FileReference[]

  @@map("files_file_management")
}

model SystemConfig {
  id          Int   @id @default(autoincrement())
  configKey   String   @unique(map: "uq_system_config_key") @map("config_key") @db.VarChar(100)
  configValue String   @map("config_value") @db.VarChar(500)
  description String?  @db.VarChar(255)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @default(now()) @map("updated_at") @db.Timestamptz(3)

  @@map("system_config")
}

model SystemHomepage {
  id        Int   @id @default(autoincrement())
  content   String   @db.Text
  status    Int      @default(1) @db.SmallInt
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz(3)
  isDeleted Boolean  @default(false) @map("is_deleted")

  @@map("system_homepage")
}

model SystemInstallation {
  id             Int       @id
  provider       String    @db.VarChar(20)
  status         String    @db.VarChar(32)
  schemaRevision Int       @map("schema_revision")
  installationId String    @unique(map: "uq_system_installation_id") @map("installation_id") @db.Uuid
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime  @default(now()) @map("updated_at") @db.Timestamptz(3)
  installedAt    DateTime? @map("installed_at") @db.Timestamptz(3)

  @@map("system_installation")
}

model ReleaseCredential {
  attributionJson String @default("{}") @map("attribution_json")
  id                   Int      @id @default(autoincrement())
  projectVersionId     Int      @map("project_version_id")
  noteContentId        Int?     @map("note_content_id")
  issuerUserId         Int?      @map("issuer_user_id")
  subjectType          String   @default("PROJECT_VERSION") @map("subject_type") @db.VarChar(32)
  subjectId            String   @map("subject_id") @db.Uuid
  subjectHash          String   @map("subject_hash") @db.Char(64)
  subjectManifestVersion Int    @map("subject_manifest_version")
  network              String   @db.VarChar(20)
  signerAddress        String   @map("signer_address") @db.VarChar(64)
  memo                 String   @db.Text
  transactionSignature String?  @unique(map: "uq_release_credential_transaction_signature") @map("transaction_signature") @db.VarChar(128)
  status               Int      @default(0) @db.SmallInt
  slot                  BigInt?  @db.BigInt
  blockTime             DateTime? @map("block_time") @db.Timestamptz(3)
  feeLamports           BigInt?  @map("fee_lamports") @db.BigInt
  finalizedAt           DateTime? @map("finalized_at") @db.Timestamptz(3)
  lastVerifiedAt        DateTime? @map("last_verified_at") @db.Timestamptz(3)
  createdAt             DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime @default(now()) @map("updated_at") @db.Timestamptz(3)
  projectVersion        ProjectVersion @relation(fields: [projectVersionId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  noteContent           NoteContent? @relation(fields: [noteContentId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  issuerUser            User? @relation("ReleaseCredentialIssuer", fields: [issuerUserId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  attempts              ReleaseCredentialAttempt[]

  @@unique([subjectType, subjectId, network], map: "uq_release_credential_subject_network")
  @@index([noteContentId], map: "idx_release_credential_note_content")
  @@index([network, status], map: "idx_release_credential_network_status")
  @@index([signerAddress], map: "idx_release_credential_signer")
  @@map("release_credential")
}

model ReleaseCredentialAttempt {
  attributionJson String @default("{}") @map("attribution_json")
  id                   Int      @id @default(autoincrement())
  credentialId         Int      @map("credential_id")
  issuerUserId         Int?      @map("issuer_user_id")
  signerAddress        String   @map("signer_address") @db.VarChar(64)
  memo                 String   @db.Text
  messageHash          String   @map("message_hash") @db.Char(64)
  recentBlockhash      String   @map("recent_blockhash") @db.VarChar(100)
  lastValidBlockHeight BigInt   @map("last_valid_block_height") @db.BigInt
  transactionSignature String?  @map("transaction_signature") @db.VarChar(128)
  status               Int      @default(0) @db.SmallInt
  failureCode          String?  @map("failure_code") @db.VarChar(64)
  failureMessage       String?  @map("failure_message") @db.VarChar(500)
  expiresAt            DateTime @map("expires_at") @db.Timestamptz(3)
  submittedAt          DateTime? @map("submitted_at") @db.Timestamptz(3)
  finalizedAt          DateTime? @map("finalized_at") @db.Timestamptz(3)
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime @default(now()) @map("updated_at") @db.Timestamptz(3)
  credential           ReleaseCredential @relation(fields: [credentialId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  issuerUser            User? @relation("ReleaseCredentialAttemptIssuer", fields: [issuerUserId], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@index([credentialId, status], map: "idx_release_credential_attempt_status")
  @@index([transactionSignature], map: "idx_release_credential_attempt_signature")
  @@map("release_credential_attempt")
}

model ArticleMembership {
  articleId Int @map("article_id")
  membershipLevelId Int @map("membership_level_id")
  article Article @relation(fields: [articleId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  membershipLevel MembershipLevel @relation(fields: [membershipLevelId], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@id([articleId, membershipLevelId])
  @@index([membershipLevelId], map: "idx_article_membership_level")
  @@map("article_membership")
}

model ProjectReadMembership {
  projectId Int @map("project_id")
  membershipLevelId Int @map("membership_level_id")
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  membershipLevel MembershipLevel @relation(fields: [membershipLevelId], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@id([projectId, membershipLevelId])
  @@index([membershipLevelId], map: "idx_project_read_membership_level")
  @@map("project_read_membership")
}

