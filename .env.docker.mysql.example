# MySQL Docker Compose deployment.
# Copy this file to .env.docker.mysql, then set both required passwords.

PORT=3000
DOCKER_IMAGE=holic512/slothvault:latest
ENCRYPTION_KEY=

# The two MySQL-mode directories never overlap with SQLite or PostgreSQL data.
APP_DATA_DIR=./docker-data/mysql/app
MYSQL_DATA_DIR=./docker-data/mysql/database

MYSQL_DATABASE=slothvault
MYSQL_USER=slothvault
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=
